{
  "name": "quran.com",
  "version": "1.0.0",
  "main": "index.js",
  "license": "MIT",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "dev:https": "node server.js",
    "prod": "node server-http.js",
    "build": "cross-env IS_BUILD_TIME=true next build",
    "postbuild": "yarn run generate-sitemap",
    "snapshots:update": "vitest run --update",
    "start": "next start",
    "lint": "eslint . --ext=tsx,ts,js,jsx",
    "lint:fix": "yarn lint --fix",
    "lint:scss": "yarn stylelint '**/*.scss' --fix",
    "ai:sync": "node scripts/ai/sync-links.mjs",
    "ai:check": "node scripts/ai/check-links.mjs",
    "generate-sitemap": "next-sitemap --config next-sitemap.js && node scripts/format-sitemap.js",
    "test": "vitest run",
    "test:integration": "playwright test",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest watch",
    "analyze": "cross-env ANALYZE_BUNDLE=true yarn build",
    "rename:v4-font-files": "node scripts/rename-v4-font-files.js",
    "remove:v4-font-files": "node scripts/remove-v4-font-files.js",
    "v4:update": "node scripts/v4-fonts-update.js",
    "arrange-files:by-extention": "node scripts/arrange-files-in-folders.js",
    "remove-files:by-name": "node scripts/remove-files.js",
    "lokalise": "node scripts/lokalise.mjs",
    "chapter-data:format": "node scripts/format-chapter-data-json.js",
    "postinstall": "husky"
  },
  "dependencies": {
    "@babel/eslint-parser": "^7.25.1",
    "@next/bundle-analyzer": "^14.2.35",
    "@radix-ui/react-checkbox": "^1.1.1",
    "@radix-ui/react-collapsible": "^1.1.0",
    "@radix-ui/react-dialog": "^1.1.1",
    "@radix-ui/react-direction": "^1.1.0",
    "@radix-ui/react-dropdown-menu": "^2.1.1",
    "@radix-ui/react-focus-scope": "1.1.0",
    "@radix-ui/react-hover-card": "^1.1.1",
    "@radix-ui/react-id": "^1.1.0",
    "@radix-ui/react-polymorphic": "^0.0.14",
    "@radix-ui/react-popover": "^1.1.1",
    "@radix-ui/react-progress": "^1.1.0",
    "@radix-ui/react-radio-group": "^1.2.0",
    "@radix-ui/react-separator": "^1.1.0",
    "@radix-ui/react-slider": "^1.2.0",
    "@radix-ui/react-switch": "^1.1.0",
    "@radix-ui/react-tabs": "^1.1.0",
    "@radix-ui/react-tooltip": "^1.1.2",
    "@radix-ui/react-visually-hidden": "^1.1.0",
    "@reduxjs/toolkit": "^2.2.7",
    "@types/crypto-js": "^4.2.2",
    "@xstate/react": "^3.0.1",
    "classnames": "^2.3.2",
    "clipboard-copy": "^4.0.1",
    "crypto-js": "^4.2.0",
    "fuse.js": "^6.6.2",
    "http-proxy-middleware": "^3.0.0",
    "humps": "^2.0.1",
    "lodash": "^4.17.21",
    "next": "^14.2.35",
    "next-fonts": "^1.0.3",
    "next-seo": "^6.5.0",
    "next-translate": "^2.6.2",
    "next-translate-plugin": "^2.6.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hotkeys-hook": "^4.5.0",
    "react-redux": "^9.1.2",
    "react-share": "^5.2.0",
    "react-toastify": "^9.0.8",
    "react-virtuoso": "^2.19.0",
    "redux": "^5.0.1",
    "redux-persist": "^6.0.0",
    "swr": "1.2.1",
    "xstate": "^4.33.6"
  },
  "devDependencies": {
    "@lokalise/node-api": "^12.7.0",
    "@next/eslint-plugin-next": "^12.3.1",
    "@playwright/test": "^1.46.1",
    "@svgr/webpack": "^8.1.0",
    "@testing-library/react": "^13.4.0",
    "@types/lodash": "^4.17.7",
    "@types/node": "^22.5.0",
    "@types/qs": "^6.9.15",
    "@types/react": "^18.3.4",
    "@types/react-dom": "^18.3.0",
    "@types/react-redux": "^7.1.23",
    "@types/wicg-mediasession": "^1.1.3",
    "@typescript-eslint/eslint-plugin": "^6.14.0",
    "@typescript-eslint/parser": "^6.14.0",
    "@vitejs/plugin-react": "^4.3.1",
    "@vitest/coverage-v8": "^2.0.5",
    "adm-zip": "^0.5.9",
    "cross-env": "^7.0.3",
    "dotenv": "^16.0.2",
    "eslint": "^8.24.0",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-config-next": "^14.2.35",
    "eslint-config-prettier": "^8.5.0",
    "eslint-plugin-i18next": "^6.0.0-4",
    "eslint-plugin-import": "^2.26.0",
    "eslint-plugin-jsdoc": "^46.9.0",
    "eslint-plugin-jsx-a11y": "^6.6.1",
    "eslint-plugin-prettier": "^4.2.1",
    "eslint-plugin-react": "^7.31.8",
    "eslint-plugin-react-func": "^0.1.18",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-sonarjs": "^0.15.0",
    "eslint-plugin-unicorn": "^43.0.2",
    "husky": "^9.1.5",
    "inquirer": "^8.0.0",
    "inquirer-file-tree-selection-prompt": "^1",
    "jsdom": "^20.0.0",
    "lint-staged": "^15.2.9",
    "next-sitemap": "^3.1.22",
    "postcss": "8.4.41",
    "postcss-scss": "^4.0.5",
    "prettier": "^2.7.1",
    "replace-in-file": "^6.3.5",
    "sass": "^1.77.8",
    "sass-loader": "^16.0.1",
    "stylelint": "14.12.1",
    "stylelint-prettier": "^2.0.0",
    "stylelint-scss": "^4.3.0",
    "stylelint-use-logical": "^2.0.0",
    "superagent": "^8.0.0",
    "typescript": "^5.5.4",
    "vite": "^5.4.2",
    "vitest": "^2.0.5"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "*.{tsx,ts}": "eslint --fix",
    "*.scss": "stylelint --fix",
    "*": "prettier --write --ignore-unknown"
  }
}
